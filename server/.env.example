# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshflow"
DB_POOL_MAX=10

# API
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN="http://localhost:5173"
# Set to true when running behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false

# Auth — use a long random string in production (min 32 chars), e.g. `openssl rand -hex 48`
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="12h"

# Reports bucket sales by this IANA timezone (store's local day)
REPORT_TIMEZONE="Asia/Kolkata"

# Initial accounts created by `npm run db:seed` (change after first sign-in)
SEED_ADMIN_NAME="Store Admin"
SEED_ADMIN_EMAIL="admin@freshflow.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_CASHIER_NAME="Front Desk Cashier"
SEED_CASHIER_EMAIL="cashier@freshflow.local"
SEED_CASHIER_PASSWORD="Cashier@12345"
# Optional: your real UPI ID so checkout QR codes work immediately
SEED_UPI_VPA=""
