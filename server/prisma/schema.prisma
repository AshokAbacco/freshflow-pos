// FreshFlow — multi-tenant grocery POS & ERP
// Prisma ORM 7 (Rust-free client via @prisma/adapter-pg)
//
// Every business record belongs to an Organization (one retail business). All queries are
// scoped by organizationId so two stores on the same deployment can never see each other's data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CASHIER
  ADMIN
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

enum StockMovementType {
  SALE
  VOID
  RESTOCK
  ADJUSTMENT
}

enum PlanTier {
  TRIAL
  STANDARD
  CUSTOM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  GRACE_PERIOD
  SUSPENDED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

/// One retail business. Everything else hangs off this.
model Organization {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  /// Registered business name, when it differs from the trading name
  legalName      String?           @map("legal_name")
  businessType   BusinessType      @default(OTHER) @map("business_type")
  city           String?
  state          String?
  /// Touched by the store's own requests; drives the "inactive 14+ days" filter
  lastActiveAt   DateTime?         @map("last_active_at")
  /// Per-organization invoice counter, so each store's bills start at 1
  invoiceSeq     Int               @default(0) @map("invoice_seq")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  users          User[]
  categories     Category[]
  products       Product[]
  transactions   Transaction[]
  stockMovements StockMovement[]
  settings       StoreSetting?
  subscription   Subscription?
  payments       Payment[]
  notes          TenantNote[]
  followUps      FollowUp[]
  subscriptionEvents SubscriptionEvent[]
  messageRecipients  PlatformMessageRecipient[]
  messageReplies     StoreMessageReply[]

  @@index([businessType])
  @@index([lastActiveAt])
  @@index([createdAt])
  @@map("organizations")
}

model Subscription {
  id                String             @id @default(uuid())
  organizationId    String             @unique @map("organization_id")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              PlanTier           @default(TRIAL)
  interval          BillingInterval    @default(MONTHLY)
  /// Number of staff accounts the plan pays for
  seats             Int                @default(3)
  status            SubscriptionStatus @default(TRIALING)
  pricePerUser      Decimal            @default(0) @map("price_per_user") @db.Decimal(10, 2)
  currency          String             @default("INR")
  trialEndsAt       DateTime?          @map("trial_ends_at")
  currentPeriodEnd  DateTime?          @map("current_period_end")
  razorpayOrderId   String?            @map("razorpay_order_id")
  razorpayPaymentId String?            @map("razorpay_payment_id")
  lastPaymentAt     DateTime?          @map("last_payment_at")
  /// End of the grace window after a lapse; overrides the platform default when set
  graceEndsAt       DateTime?          @map("grace_ends_at")
  suspendedAt       DateTime?          @map("suspended_at")
  suspendedReason   String?            @map("suspended_reason")
  cancelledAt       DateTime?          @map("cancelled_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              PlanTier
  interval          BillingInterval
  seats             Int
  /// What we asked Razorpay to charge, in rupees
  amount            Decimal         @db.Decimal(12, 2)
  /// What Razorpay reports it actually captured; must match `amount` before a plan is activated
  amountCaptured    Decimal?        @map("amount_captured") @db.Decimal(12, 2)
  amountRefunded    Decimal         @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(CREATED)
  /// upi | card | netbanking | wallet, as reported by Razorpay
  method            String?
  razorpayOrderId   String          @unique @map("razorpay_order_id")
  razorpayPaymentId String?         @map("razorpay_payment_id")
  /// Kept for dispute evidence: proves this handover came from Razorpay
  razorpaySignature String?         @map("razorpay_signature")
  failureReason     String?         @map("failure_reason")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("payments")
}

/// Log of every signed webhook Razorpay delivered.
/// Razorpay retries an un-acknowledged webhook for up to 24 hours, so the unique event id is
/// what stops a retry from being applied twice. Also the audit trail when a payment is disputed.
model WebhookEvent {
  id         String   @id @default(uuid())
  /// Razorpay's x-razorpay-event-id header: unique per event, stable across retries
  eventId    String   @unique @map("event_id")
  event      String
  orderId    String?  @map("order_id")
  paymentId  String?  @map("payment_id")
  payload    String
  handled    Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([orderId])
  @@map("webhook_events")
}

model User {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String        @unique
  passwordHash   String        @map("password_hash")
  phone          String?
  role           Role          @default(CASHIER)
  isActive       Boolean       @default(true) @map("is_active")
  lastLoginAt    DateTime?     @map("last_login_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  transactions   Transaction[]

  @@index([organizationId])
  @@map("users")
}

/// Two-level tree: departments (parentId = null) and their sub-categories. Admins manage these.
model Category {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  icon           String?
  sortOrder      Int               @default(0) @map("sort_order")
  parentId       String?           @map("parent_id")
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryTree")
  products       Product[]
  soldItems      TransactionItem[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  barcode           String?
  name              String
  description       String?
  categoryId        String            @map("category_id")
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price             Decimal           @db.Decimal(12, 2)
  unit              String            @default("pcs")
  soldByWeight      Boolean           @default(false) @map("sold_by_weight")
  stock             Decimal           @default(0) @db.Decimal(14, 3)
  lowStockThreshold Decimal           @default(5) @map("low_stock_threshold") @db.Decimal(14, 3)
  discountPercent   Decimal           @default(0) @map("discount_percent") @db.Decimal(5, 2)
  isQuickKey        Boolean           @default(false) @map("is_quick_key")
  imageUrl          String?           @map("image_url")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  soldItems         TransactionItem[]
  stockMovements    StockMovement[]

  @@unique([organizationId, code])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([categoryId])
  @@map("products")
}

model Transaction {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Generated on the terminal; makes offline sync idempotent
  clientId       String            @unique @map("client_id")
  /// Sequential within the organization
  invoiceNo      Int               @map("invoice_no")
  terminalId     String            @map("terminal_id")
  cashierId      String            @map("cashier_id")
  cashier        User              @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  syncedById     String?           @map("synced_by_id")
  status         TransactionStatus @default(COMPLETED)
  paymentMethod  PaymentMethod     @map("payment_method")
  customerPhone  String?           @map("customer_phone")
  subtotal       Decimal           @db.Decimal(12, 2)
  itemDiscount   Decimal           @map("item_discount") @db.Decimal(12, 2)
  billDiscount   Decimal           @map("bill_discount") @db.Decimal(12, 2)
  discountReason String?           @map("discount_reason")
  taxRate        Decimal           @map("tax_rate") @db.Decimal(5, 2)
  taxableAmount  Decimal           @map("taxable_amount") @db.Decimal(12, 2)
  taxTotal       Decimal           @map("tax_total") @db.Decimal(12, 2)
  grandTotal     Decimal           @map("grand_total") @db.Decimal(12, 2)
  amountTendered Decimal?          @map("amount_tendered") @db.Decimal(12, 2)
  changeDue      Decimal?          @map("change_due") @db.Decimal(12, 2)
  wasOffline     Boolean           @default(false) @map("was_offline")
  soldAt         DateTime          @map("sold_at")
  syncedAt       DateTime          @default(now()) @map("synced_at")
  voidedAt       DateTime?         @map("voided_at")
  voidedById     String?           @map("voided_by_id")
  voidReason     String?           @map("void_reason")
  items          TransactionItem[]

  @@unique([organizationId, invoiceNo])
  @@index([organizationId, soldAt])
  @@index([cashierId, soldAt])
  @@map("transactions")
}

model TransactionItem {
  id                String      @id @default(uuid())
  transactionId     String      @map("transaction_id")
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId         String      @map("product_id")
  product           Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  categoryId        String      @map("category_id")
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productName       String      @map("product_name")
  productCode       String      @map("product_code")
  unit              String
  soldByWeight      Boolean     @map("sold_by_weight")
  quantity          Decimal     @db.Decimal(14, 3)
  unitPrice         Decimal     @map("unit_price") @db.Decimal(12, 2)
  discountPercent   Decimal     @map("discount_percent") @db.Decimal(5, 2)
  lineSubtotal      Decimal     @map("line_subtotal") @db.Decimal(12, 2)
  lineDiscount      Decimal     @map("line_discount") @db.Decimal(12, 2)
  billDiscountShare Decimal     @map("bill_discount_share") @db.Decimal(12, 2)
  netAmount         Decimal     @map("net_amount") @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([productId])
  @@index([categoryId])
  @@map("transaction_items")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String            @map("product_id")
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  reason         String?
  referenceId    String?           @map("reference_id")
  userId         String?           @map("user_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model StoreSetting {
  id                    String       @id @default(uuid())
  organizationId        String       @unique @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeName             String       @map("store_name")
  tagline               String?
  gstin                 String?
  address               String?
  phone                 String?
  upiVpa                String?      @map("upi_vpa")
  upiPayeeName          String?      @map("upi_payee_name")
  currency              String       @default("INR")
  taxRate               Decimal      @default(5) @map("tax_rate") @db.Decimal(5, 2)
  maxCashierDiscountPct Decimal      @default(10) @map("max_cashier_discount_pct") @db.Decimal(5, 2)
  receiptFooter         String?      @map("receipt_footer")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@map("store_settings")
}

// ===========================================================================
// Platform Admin — the software company's back office.
//
// Deliberately separate from the store-facing models above. Platform staff live in their own
// table, so a store owner can never become a platform admin even with the same email address.
// ===========================================================================

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
}

enum BusinessType {
  SUPERMARKET
  KIRANA
  MINI_MART
  HYPERMARKET
  WHOLESALE
  OTHER
}

enum FollowUpType {
  RENEWAL
  PAYMENT_FAILED
  ONBOARDING
  SUPPORT_ISSUE
  UPSELL
  OTHER
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
}

enum SubscriptionEventType {
  TRIAL_STARTED
  PAID
  RENEWED
  PLAN_CHANGED
  EXTENDED
  ENTERED_GRACE
  EXPIRED
  SUSPENDED
  REACTIVATED
  CANCELLED
  REFUNDED
}

/// Staff of the software company.
model PlatformAdmin {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  phone         String?
  role          PlatformRole @default(SUPPORT)
  passwordHash  String       @map("password_hash")
  /// Encrypted by the application before it is stored, never the raw shared secret
  totpSecret    String?      @map("totp_secret")
  totpEnabled   Boolean      @default(false) @map("totp_enabled")
  isActive      Boolean      @default(true) @map("is_active")
  failedLogins  Int          @default(0) @map("failed_logins")
  lockedUntil   DateTime?    @map("locked_until")
  lastLoginAt   DateTime?    @map("last_login_at")
  passwordSetAt DateTime     @default(now()) @map("password_set_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  sessions       PlatformSession[]
  passwordTokens PlatformPasswordToken[]
  auditEntries   AuditLog[]
  notes          TenantNote[]
  assignedFollowUps FollowUp[] @relation("FollowUpAssignee")
  createdFollowUps  FollowUp[] @relation("FollowUpCreator")

  @@index([role, isActive])
  @@map("platform_admins")
}

/// One row per sign-in, so "sign out all sessions" can revoke a token before it expires.
model PlatformSession {
  id         String        @id @default(uuid())
  adminId    String        @map("admin_id")
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token; the token itself is never stored
  tokenHash  String        @unique @map("token_hash")
  ip         String?
  userAgent  String?       @map("user_agent")
  createdAt  DateTime      @default(now()) @map("created_at")
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  expiresAt  DateTime      @map("expires_at")
  revokedAt  DateTime?     @map("revoked_at")

  @@index([adminId, revokedAt])
  @@map("platform_sessions")
}

/// Single-use expiring tokens for forgot-password and invite links.
model PlatformPasswordToken {
  id        String        @id @default(uuid())
  adminId   String        @map("admin_id")
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String        @unique @map("token_hash")
  purpose   String        @default("RESET")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([adminId])
  @@map("platform_password_tokens")
}

/// Platform-wide configuration, one row per key.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Every platform action, with the reason the operator gave for it.
model AuditLog {
  id             String         @id @default(uuid())
  /// Null for scheduled jobs, which record actorLabel instead
  actorAdminId   String?        @map("actor_admin_id")
  actorAdmin     PlatformAdmin? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)
  actorLabel     String         @map("actor_label")
  actorRole      String?        @map("actor_role")
  action         String
  /// No relation on purpose: an audit row must outlive the store it refers to
  organizationId String?        @map("organization_id")
  targetType     String?        @map("target_type")
  targetId       String?        @map("target_id")
  reason         String?
  /// Small before/after summary, not a full row dump
  changes        Json?
  ip             String?
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Subscription history, so the store page can show a real timeline rather than a guess.
model SubscriptionEvent {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           SubscriptionEventType
  fromStatus     SubscriptionStatus?   @map("from_status")
  toStatus       SubscriptionStatus?   @map("to_status")
  fromPlan       PlanTier?             @map("from_plan")
  toPlan         PlanTier?             @map("to_plan")
  periodEnd      DateTime?             @map("period_end")
  amount         Decimal?              @db.Decimal(12, 2)
  reason         String?
  actorLabel     String                @default("system") @map("actor_label")
  actorAdminId   String?               @map("actor_admin_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("subscription_events")
}

/// Internal support notes. Never shown to the store.
model TenantNote {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorAdminId  String?        @map("author_admin_id")
  author         PlatformAdmin? @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  authorLabel    String         @map("author_label")
  body           String
  pinned         Boolean        @default(false)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([organizationId, pinned, createdAt])
  @@map("tenant_notes")
}

/// Renewal chasing and support tasks.
model FollowUp {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  type           FollowUpType     @default(OTHER)
  status         FollowUpStatus   @default(OPEN)
  priority       FollowUpPriority @default(NORMAL)
  dueAt          DateTime         @map("due_at")
  assigneeId     String?          @map("assignee_id")
  assignee       PlatformAdmin?   @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?          @map("created_by_id")
  createdBy      PlatformAdmin?   @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  result         String?
  /// Set by the daily job, e.g. "RENEWAL:<orgId>:2026-12-01". Unique, so a job that runs
  /// twice cannot raise the same follow-up twice.
  autoKey        String?          @unique @map("auto_key")
  closedAt       DateTime?        @map("closed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([assigneeId, status, dueAt])
  @@index([organizationId, status])
  @@map("follow_ups")
}

/// A plan as a commercial record rather than a constant in a file.
///
/// Prices change and old plans have to keep billing the stores already on them, so plans are
/// retired rather than deleted. A null limit means unlimited -- deliberately not a large
/// number, because "unlimited" and "a million" are different promises to a customer.
model Plan {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  blurb            String?
  isActive         Boolean   @default(true) @map("is_active")
  /// Shown on the public pricing page. The trial is sold by signing up, not by choosing it.
  isPublic         Boolean   @default(true) @map("is_public")
  sortOrder        Int       @default(0) @map("sort_order")

  maxUsers         Int?      @map("max_users")
  maxProducts      Int?      @map("max_products")
  maxBillsPerMonth Int?      @map("max_bills_per_month")

  features         Json      @default("[]")

  monthlyListPrice Decimal   @default(0) @map("monthly_list_price") @db.Decimal(10, 2)
  monthlyPrice     Decimal   @default(0) @map("monthly_price") @db.Decimal(10, 2)
  yearlyListPrice  Decimal   @default(0) @map("yearly_list_price") @db.Decimal(10, 2)
  yearlyPrice      Decimal   @default(0) @map("yearly_price") @db.Decimal(10, 2)
  currency         String    @default("INR")

  retiredAt        DateTime? @map("retired_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("plans")
}

/// A message sent to stores, read inside their own app. No SMS or WhatsApp provider involved.
model PlatformMessage {
  id             String                     @id @default(uuid())
  subject        String
  body           String
  /// The filter this was aimed at, kept as sent: re-deriving "who got this" from a live
  /// filter months later would give a different answer as stores change state.
  audience       Json                       @default("{}")
  channel        String                     @default("IN_APP")
  status         String                     @default("DRAFT")
  /// BROADCAST for a campaign, DIRECT for an answer to one shop. Keeps a reply out of the
  /// broadcast list, where it would look like a campaign sent to a single store.
  kind           String                     @default("BROADCAST")
  /// The store message this answers, when it is an answer. SetNull so deleting the question
  /// never deletes the reply, which is part of the support record.
  inReplyToId    String?                    @map("in_reply_to_id")
  inReplyTo      StoreMessageReply?         @relation("ReplyThread", fields: [inReplyToId], references: [id], onDelete: SetNull)
  createdById    String?                    @map("created_by_id")
  createdByLabel String                     @default("system") @map("created_by_label")
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  recipients     PlatformMessageRecipient[]
  replies        StoreMessageReply[]        @relation("MessageReplies")

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([inReplyToId])
  @@map("platform_messages")
}

model PlatformMessageRecipient {
  id             String          @id @default(uuid())
  messageId      String          @map("message_id")
  message        PlatformMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readAt         DateTime?       @map("read_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([messageId, organizationId])
  @@index([organizationId, readAt])
  @@map("platform_message_recipients")
}

/// What a store wrote back. The inbox is the unhandled ones, oldest first.
model StoreMessageReply {
  id             String           @id @default(uuid())
  /// Null when a store starts a thread itself. SetNull rather than Cascade so deleting a
  /// campaign never deletes the replies it provoked.
  messageId      String?          @map("message_id")
  message        PlatformMessage? @relation("MessageReplies", fields: [messageId], references: [id], onDelete: SetNull)
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?          @map("user_id")
  authorLabel    String           @map("author_label")
  body           String
  handledAt      DateTime?        @map("handled_at")
  handledById    String?          @map("handled_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  /// Answers the platform sent about this message.
  answers        PlatformMessage[] @relation("ReplyThread")

  @@index([handledAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("store_message_replies")
}
